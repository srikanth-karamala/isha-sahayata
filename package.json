{
  "name": "yellow-cycle-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:history": "pnpm exec ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-history.ts",
    "db:backfill-matches": "pnpm exec ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/backfill-matches.ts",
    "db:shuttle-coords": "pnpm exec ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-shuttle-coords.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@prisma/client": "^5.22.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^6.6.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright-core": "^1.63.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "ws": "^8.21.3"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "prisma": {
    "seed": "pnpm exec ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
