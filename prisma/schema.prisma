generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CycleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum RideStatus {
  ACTIVE
  COMPLETED
}

enum FaultCategory {
  BRAKES
  CHAIN
  TYRE
  FRAME
  ELECTRICAL
  OTHER
}

enum FaultSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum LostFoundKind {
  LOST
  FOUND
}

enum LostFoundStatus {
  OPEN
  CLAIMED
  /// Kept out of matching but not deleted, so the record survives.
  ARCHIVED
}

enum ItemCategory {
  CLOTHING
  BOTTLE
  BAG
  ELECTRONICS
  DOCUMENTS
  EYEWEAR
  JEWELLERY
  KEYS
  BOOK
  OTHER
}

enum AuditAction {
  CHECKOUT
  DROP_OFF
  REPORT_FAULT
  REPAIRED
}

model User {
  id         String          @id @default(uuid())
  name       String
  phone      String          @unique
  createdAt  DateTime        @default(now())
  heldCycles Cycle[]
  rides      Ride[]
  lostFound  LostFoundItem[]
}

model Cycle {
  id             String      @id @default(uuid())
  qrCode         String      @unique
  status         CycleStatus @default(AVAILABLE)
  currentHubId   String
  currentHub     Hub         @relation(fields: [currentHubId], references: [id])
  latitude       Float?
  longitude      Float?
  issueNotes     String?
  issuePhotoUrl  String?
  repairPhotoUrl String?

  /// AI triage of issueNotes (and the fault photo when present), written by
  /// lib/triage.ts on report. Null until a fault has been triaged.
  faultCategory FaultCategory?
  faultSeverity FaultSeverity?
  /// false = unsafe to ride; pull from service immediately.
  safeToRide    Boolean?
  faultSummary  String?
  triagedAt     DateTime?
  heldByUserId  String?
  heldByUser    User?          @relation(fields: [heldByUserId], references: [id])
  updatedAt     DateTime       @updatedAt
  logs          AuditLog[]
  rides         Ride[]
}

model Ride {
  id             String          @id @default(uuid())
  cycleId        String
  cycle          Cycle           @relation(fields: [cycleId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  qrCode         String
  status         RideStatus      @default(ACTIVE)
  distanceMeters Float           @default(0)
  lastLat        Float?
  lastLng        Float?
  startHubId     String
  endHubId       String?
  startedAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  endedAt        DateTime?
  pathPoints     RidePathPoint[]

  @@index([status, updatedAt])
  @@index([userId, status])
  @@index([cycleId, status])
}

/// Ordered GPS samples for a ride — replaces the old pathJson blob.
model RidePathPoint {
  id         String   @id @default(uuid())
  rideId     String
  ride       Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  seq        Int
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  @@unique([rideId, seq])
  @@index([rideId])
}

model Hub {
  id        String          @id @default(uuid())
  name      String          @unique
  capacity  Int             @default(20)
  latitude  Float?
  longitude Float?
  cycles    Cycle[]
  startLogs AuditLog[]      @relation("StartHub")
  endLogs   AuditLog[]      @relation("EndHub")
  lostFound LostFoundItem[]
}

model AuditLog {
  id             String      @id @default(uuid())
  cycleId        String
  cycle          Cycle       @relation(fields: [cycleId], references: [id])
  /// Rider User.id when known; staff actions may use a sentinel like "admin-staff".
  userId         String
  startHubId     String
  startHub       Hub         @relation("StartHub", fields: [startHubId], references: [id])
  endHubId       String?
  endHub         Hub?        @relation("EndHub", fields: [endHubId], references: [id])
  latitude       Float?
  longitude      Float?
  distanceMeters Float?
  action         AuditAction
  createdAt      DateTime    @default(now())

  @@index([action, createdAt])
}

/// A lost or found report. One model for both directions: the only difference
/// is `kind`, which keeps matching symmetrical — a LOST report is matched
/// against FOUND entries and vice versa.
model LostFoundItem {
  id     String          @id @default(uuid())
  kind   LostFoundKind
  status LostFoundStatus @default(OPEN)

  /// What the person actually typed. Matching reads this, not the category.
  description String
  /// AI-assigned; falls back to keyword rules when Claude is unavailable.
  category    ItemCategory?
  /// Short staff-facing label derived from the description.
  title       String?
  photoUrl    String?

  /// Where it was lost or found. Hub is optional — plenty of things go missing
  /// between stations.
  hubId     String?
  hub       Hub?    @relation(fields: [hubId], references: [id])
  placeNote String?
  latitude  Float?
  longitude Float?

  /// When it was lost or found, as reported — not when the row was created.
  occurredAt   DateTime
  reportedById String
  reportedBy   User     @relation(fields: [reportedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchesAsSource MatchSuggestion[] @relation("SourceItem")
  matchesAsTarget MatchSuggestion[] @relation("TargetItem")

  @@index([kind, status, occurredAt])
}

/// A possible pairing between a LOST and a FOUND report, scored by Claude.
/// Stored rather than computed per request so staff see a stable list and the
/// same pair is not re-scored on every page load.
model MatchSuggestion {
  id       String        @id @default(uuid())
  sourceId String
  source   LostFoundItem @relation("SourceItem", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   LostFoundItem @relation("TargetItem", fields: [targetId], references: [id], onDelete: Cascade)

  /// 0-100. Above 60 is surfaced to the person who reported the loss.
  score     Int
  /// One sentence on why these two look like the same object.
  reasoning String
  /// True when Claude scored it, false when the keyword fallback did.
  byAi      Boolean  @default(false)
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId])
  @@index([sourceId, score])
}

/// An uploaded photo, stored in the database rather than on disk.
///
/// The app runs on serverless hosting where the filesystem is read-only and
/// wiped between invocations, so writing to public/uploads is not an option.
/// These are phone snapshots of a bicycle fault or a found item — small enough
/// that a bytea column is simpler and cheaper than adding an object store.
model Upload {
  id        String   @id @default(uuid())
  /// 'faults', 'repairs' or 'lost-found'.
  folder    String
  mimeType  String
  bytes     Bytes
  createdAt DateTime @default(now())

  @@index([folder, createdAt])
}

/// A place a shuttle stops. Separate from Hub: a cycle stand is inventory
/// (docks, capacity, cycles held), a shuttle stop is only a named place a
/// vehicle calls at. Some are the same physical spot — Bhiksha Hall has both
/// — but conflating them would give every stop a capacity it does not have.
///
/// `latitude` and `longitude` are nullable on purpose. Only the six cycle
/// stands have been surveyed; the shuttle stops are named in the ashram's
/// published route list but nobody has recorded where they are. The list view
/// works without them, and the map layer can be added the day they arrive
/// without touching this model.
model ShuttleStop {
  id        String             @id @default(uuid())
  name      String             @unique
  /// Written on a noticeboard or said aloud — "the metal bridge near Bhiksha
  /// Hall" is how people refer to one of these, and it is not a place name.
  note      String?
  latitude  Float?
  longitude Float?
  /// Where this stop sits on each route that calls at it.
  calls     ShuttleRouteStop[]
  createdAt DateTime           @default(now())
}

/// A fixed shuttle route. The five in use came from the ashram's published
/// list and are confirmed; their running hours are not, which is why
/// `hours` is nullable rather than carrying a guess.
model ShuttleRoute {
  id             String             @id @default(uuid())
  name           String             @unique
  /// BUGGY for the electric carts, BULLOCK for the bullock cart routes.
  kind           ShuttleKind        @default(BUGGY)
  /// "6:00am to 8:30pm", when someone has read it off the board. Null means
  /// nobody has checked, and the interface says so rather than inventing one.
  hours          String?
  /// Set once the hours have been confirmed on site, mirroring the
  /// convention in lib/ashram-knowledge.ts.
  hoursCheckedAt DateTime?
  stops          ShuttleRouteStop[]
  createdAt      DateTime           @default(now())
}

/// A stop's place in a route's sequence. The join carries `position` because
/// the order is the useful part — "which buggy takes me from Welcome Point to
/// Shivapadam" is answered by two stops on one route, in order.
model ShuttleRouteStop {
  id       String       @id @default(uuid())
  routeId  String
  route    ShuttleRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId   String
  stop     ShuttleStop  @relation(fields: [stopId], references: [id], onDelete: Cascade)
  position Int

  @@unique([routeId, position])
  @@unique([routeId, stopId])
  @@index([stopId])
}

enum ShuttleKind {
  BUGGY
  BULLOCK
}
